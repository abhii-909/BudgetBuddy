{
  "expo": {
    "name": "BudgetBuddy",
    "slug": "budget-buddy",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "budgetbuddy",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#0A0E1A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BudgetBuddy needs access to your photos to set a profile picture."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgetbuddy.app"
    },
    "android": {
      "package": "com.budgetbuddy.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "versionCode": 2
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ad08265-2da5-4d2d-8954-1d9f6af5b757"
      }
    }
  }
}
